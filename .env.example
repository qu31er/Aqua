# Переменные окружения (на Railway задаются во вкладке Variables)
AQUA_SECRET_KEY=длинная-случайная-строка      # обязательно! python3 -c "import secrets; print(secrets.token_urlsafe(64))"
AQUA_DATA_DIR=/data                           # путь, куда смонтирован Volume (база и загрузки)
AQUA_MAX_UPLOAD_MB=50
AQUA_JWT_TTL_HOURS=168
